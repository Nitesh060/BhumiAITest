# Runtime
ENVIRONMENT=production
PORT=5000
LOG_LEVEL=INFO

# Required in production
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGIN=https://your-frontend-domain.example

# Database
DATABASE_URL=postgresql://...

# Earth Engine
GEE_SERVICE_ACCOUNT=service-account@example.iam.gserviceaccount.com
GEE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
GEE_PROJECT_ID=your-gcp-project

# Gemini
GEMINI_API_KEY=...

# WhatsApp Cloud API
WHATSAPP_TOKEN=...
WHATSAPP_PHONE_ID=...
WHATSAPP_VERIFY_TOKEN=...
WHATSAPP_APP_SECRET=...
WHATSAPP_GRAPH_API_VERSION=v20.0

# Optional abuse controls
RATE_LIMIT_PER_MINUTE=20
RATE_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=2097152
